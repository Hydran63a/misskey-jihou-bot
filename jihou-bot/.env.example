# ===== Misskey =====
# 投稿先のMisskeyサーバー（末尾のスラッシュは不要）
MISSKEY_URL=https://misskey.example.com
# botアカウントのアクセストークン（「ノートを作成・削除する」権限が必要）
MISSKEY_TOKEN=YOUR_MISSKEY_TOKEN

# 投稿の公開範囲：public / home / followers
NOTE_VISIBILITY=public
# true にすると連合なし（ローカル限定）で投稿する
LOCAL_ONLY=true

# ===== bot の振る舞い =====
# 使用するキャラクター（characters/ 内のフォルダ名、または ./my-chara のようなパス）
CHARACTER=koyomi
# 21〜23時のリマインダーでメンションする相手（例：@user@misskey.example.com）
# 空欄ならメンションせずに投稿する
REMINDER_TARGET=
# botが話しかける相手の呼び名。空欄なら名前で呼びかけない
OWNER_NAME=
# 時報のタイムゾーン（IANA形式）
TIMEZONE=Asia/Tokyo

# ===== Gemini =====
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== 保存先 =====
# 投稿履歴（重複チェック用）と最近の献立を保存するフォルダ（相対パスはこのフォルダ基準）
DATA_DIR=./data

# ===== 監視bot（オプション） =====
# error-kanshi-bot を使う場合は true にする（Geminiの稼働状態をファイルに書き込む）
STATUS_MONITOR=false
# 監視botと共有する稼働状態ファイル（相対パスはこのフォルダ基準）
# 監視bot側の GEMINI_STATUS_FILE と同じ場所を指すようにしてください
GEMINI_STATUS_FILE=../data/gemini-status.json
